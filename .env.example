# Public (safe in the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_DEFAULT_MARKET=saipan

# Server-only. Never expose these to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional. Leave empty to use the mock extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_RETRY=gemini-2.5-pro

# Optional. Leave empty to skip Google Places and use the LocalPrice registry only.
GOOGLE_PLACES_API_KEY=

# Feature flags: "true" or "false"
FEATURE_RECEIPT_UPLOAD=true
FEATURE_GEMINI_EXTRACTION=false
FEATURE_GOOGLE_PLACES=false
FEATURE_BASKET_COMPARISON=true
FEATURE_MODERATION=true

# Receipt image retention window in days (14-30).
RECEIPT_RETENTION_DAYS=21

# Cron secret for retention and job workers on Vercel.
CRON_SECRET=generate-a-long-random-string
